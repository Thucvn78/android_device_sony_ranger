# mount_point   fstype    device                  [device2]    flags
/boot           emmc      /dev/block/platform/bootdevice/by-name/boot
/recovery       emmc      /dev/block/platform/bootdevice/by-name/recovery
/system         ext4      /dev/block/platform/bootdevice/by-name/system    flags=display="System"
/data           ext4      /dev/block/platform/bootdevice/by-name/userdata  flags=length=-16384
/cache          ext4      /dev/block/platform/bootdevice/by-name/cache     flags=display="Cache"
/persist        ext4      /dev/block/platform/bootdevice/by-name/persist   flags=display="Persist";backup=1
/nvram          emmc      /dev/block/platform/bootdevice/by-name/nvram     flags=display="NVRAM";backup=1

# External Storage (Thẻ nhớ SD và USB OTG)
/external_sd    auto      /dev/block/mmcblk1p1    /dev/block/mmcblk1       flags=display="MicroSD";storage;wipeingui;removable
/usb_otg        auto      /dev/block/sda1         /dev/block/sda           flags=display="USB OTG";storage;wipeingui;removable
