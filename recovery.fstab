# mount point       fstype    device            device2          flags
/boot               emmc      /dev/block/platform/soc/11240000.mmc/by-name/boot
/recovery           emmc      /dev/block/platform/soc/11240000.mmc/by-name/FOTAKernel
/system             ext4      /dev/block/platform/soc/11240000.mmc/by-name/system
/data               ext4      /dev/block/platform/soc/11240000.mmc/by-name/userdata        flags=encryptable=footer;length=-1
/cache              ext4      /dev/block/platform/soc/11240000.mmc/by-name/cache
/external_sd        auto      /dev/block/mmcblk1p1    /dev/block/mmcblk1         flags=display="MicroSD";storage;wipeingui;removable
